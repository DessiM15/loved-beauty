# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://lovedbeautyshop.net

# ---- Shopify (leave blank to run with the built-in mock catalog) ----
# Shopify Admin → Sales channels → Headless (or Apps → Develop apps → Storefront API)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Shopify Admin → Settings → Notifications → Webhooks → signing secret
SHOPIFY_WEBHOOK_SECRET=
# Set to "mock" to show the placeholder catalog even with Shopify credentials set (while the store is empty). Remove to go live.
COMMERCE_SOURCE=

# ---- Contact form (Resend, free tier) ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=lovedbeautyshop@gmail.com
CONTACT_FROM_EMAIL=

# ---- Analytics (set once accounts exist) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Shade finder (selfie analysis via Claude; the 3-question quiz works without it) ----
ANTHROPIC_API_KEY=
SHADE_MATCH_MODEL=claude-opus-5

# ---- Feature flags ----
NEXT_PUBLIC_SHOW_REVIEWS=false
NEXT_PUBLIC_SHOW_WELCOME_POPUP=true

# ---- Header review switch (V1 cream bar with haze / V2 solid black bar). Remove at launch and set the winner. ----
NEXT_PUBLIC_NAV_TOGGLE=true
NEXT_PUBLIC_NAV_STYLE=light
